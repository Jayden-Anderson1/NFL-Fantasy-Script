<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Draft War Room — 2026 Fantasy Board</title>
<style>
  :root{
    --bg:#0E1512;
    --surface:#161F1A;
    --surface2:#1E2A23;
    --surface3:#232F28;
    --border:#2A3830;
    --text:#EDEDE2;
    --text-muted:#93A296;
    --text-dim:#5F6E63;
    --accent:#F2B705;
    --accent-dim:#8A6C1E;
    --qb:#E2543B;
    --rb:#4A90D9;
    --wr:#B37FEB;
    --te:#F2A65A;
    --k:#58C4B0;
    --dst:#9AA5AE;
    --good:#6FBF73;
    --warn:#E2544B;
    --radius:10px;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  @font-face{
    font-family:'Anton';
    src:local('Anton');
  }
  .display{
    font-family:'Anton','Arial Narrow',sans-serif;
    letter-spacing:0.02em;
    text-transform:uppercase;
  }
  .mono{ font-family:'IBM Plex Mono','SF Mono',Consolas,monospace; }

  header{
    padding:28px 20px 18px;
    border-bottom:1px solid var(--border);
    background:linear-gradient(180deg, rgba(242,183,5,0.06), transparent);
  }
  .header-inner{ max-width:1100px; margin:0 auto; }
  h1{
    font-size:clamp(28px,5vw,44px);
    margin:0 0 4px;
    color:var(--text);
    line-height:0.95;
  }
  h1 span{ color:var(--accent); }
  .subtitle{ color:var(--text-muted); font-size:14px; margin-bottom:16px; }

  .scoring-chips{
    display:flex; flex-wrap:wrap; gap:6px; margin-top:10px;
  }
  .chip{
    font-size:11px; padding:4px 9px; border-radius:99px;
    background:var(--surface2); border:1px solid var(--border);
    color:var(--text-muted); font-family:'IBM Plex Mono',monospace;
    white-space:nowrap;
  }

  .controls{
    position:sticky; top:0; z-index:20;
    background:rgba(14,21,18,0.97);
    backdrop-filter:blur(6px);
    border-bottom:1px solid var(--border);
    padding:12px 20px;
  }
  .controls-inner{
    max-width:1100px; margin:0 auto;
    display:flex; flex-wrap:wrap; gap:10px; align-items:center;
  }
  .pos-tabs{ display:flex; gap:4px; flex-wrap:wrap; }
  .pos-tab{
    font-family:'IBM Plex Mono',monospace;
    font-size:12px; font-weight:600;
    padding:7px 12px; border-radius:7px;
    background:var(--surface); border:1px solid var(--border);
    color:var(--text-muted); cursor:pointer;
    transition:all .12s ease;
    user-select:none;
  }
  .pos-tab:hover{ border-color:var(--text-dim); color:var(--text); }
  .pos-tab.active{ background:var(--surface3); color:var(--text); border-color:var(--accent); }
  .pos-tab .dot{
    display:inline-block; width:7px;height:7px;border-radius:50%;
    margin-right:6px; vertical-align:middle;
  }

  .search-wrap{ position:relative; flex:1; min-width:160px; max-width:280px; }
  .search-wrap input{
    width:100%; padding:8px 12px 8px 30px; border-radius:7px;
    background:var(--surface); border:1px solid var(--border);
    color:var(--text); font-size:13px; outline:none;
  }
  .search-wrap input:focus{ border-color:var(--accent); }
  .search-wrap svg{ position:absolute; left:9px; top:9px; opacity:0.5; }

  .toggle-board{
    display:flex; align-items:center; gap:7px;
    padding:7px 12px; border-radius:7px;
    background:var(--surface); border:1px solid var(--border);
    color:var(--text-muted); cursor:pointer; font-size:12px;
    font-family:'IBM Plex Mono',monospace; user-select:none;
    white-space:nowrap;
  }
  .toggle-board.active{ border-color:var(--accent); color:var(--accent); background:rgba(242,183,5,0.08); }
  .toggle-board .star{ font-size:13px; }

  .count-badge{
    margin-left:auto; font-size:12px; color:var(--text-dim);
    font-family:'IBM Plex Mono',monospace;
  }

  main{ max-width:1100px; margin:0 auto; padding:16px 20px 80px; }

  .empty-state{
    text-align:center; padding:60px 20px; color:var(--text-dim);
  }

  .row{
    display:flex; align-items:flex-start; gap:12px;
    background:var(--surface); border:1px solid var(--border);
    border-left:4px solid var(--pos-color, var(--border));
    border-radius:var(--radius);
    padding:12px 14px; margin-bottom:8px;
    transition:background .12s ease;
  }
  .row:hover{ background:var(--surface2); }
  .row.highlighted{
    background:rgba(242,183,5,0.06);
    border-color:rgba(242,183,5,0.4);
    border-left-color:var(--accent);
  }

  .rank-badge{
    min-width:38px; text-align:center;
    font-family:'Anton',sans-serif; font-size:20px;
    color:var(--text-dim); padding-top:2px;
  }
  .row.highlighted .rank-badge{ color:var(--accent); }

  .row-main{ flex:1; min-width:0; }
  .row-top{ display:flex; align-items:baseline; gap:8px; flex-wrap:wrap; }
  .player-name{ font-size:15.5px; font-weight:600; color:var(--text); }
  .pos-chip{
    font-family:'IBM Plex Mono',monospace; font-size:10.5px; font-weight:700;
    padding:1px 6px; border-radius:4px; color:#0E1512;
    background:var(--pos-color, var(--text-dim));
  }
  .team-bye{ font-size:12px; color:var(--text-muted); font-family:'IBM Plex Mono',monospace; }
  .tier-label{ font-size:11.5px; color:var(--text-dim); font-style:italic; }

  .row-meta{
    display:flex; flex-wrap:wrap; gap:6px; margin-top:6px;
  }
  .tag{
    font-size:11px; padding:3px 8px; border-radius:6px;
    border:1px solid var(--border); color:var(--text-muted);
    display:flex; align-items:center; gap:4px;
  }
  .tag.injury{ color:#F0A79A; border-color:rgba(226,84,75,0.35); background:rgba(226,84,75,0.07); }
  .tag.schedule-good{ color:#9BDB9E; border-color:rgba(111,191,115,0.3); background:rgba(111,191,115,0.06); }
  .tag.schedule-bad{ color:#E2A05B; border-color:rgba(226,160,91,0.3); background:rgba(226,160,91,0.06); }
  .tag.ppg{ color:var(--text); font-family:'IBM Plex Mono',monospace; }

  .row-actions{
    display:flex; flex-direction:column; align-items:center; gap:8px;
    padding-top:2px;
  }
  .star-btn{
    background:none; border:none; cursor:pointer; font-size:20px;
    color:var(--text-dim); line-height:1; padding:2px;
    transition:transform .1s ease, color .1s ease;
  }
  .star-btn:hover{ transform:scale(1.15); }
  .star-btn.active{ color:var(--accent); }
  .note-btn{
    background:none; border:1px solid var(--border); border-radius:6px;
    cursor:pointer; font-size:11px; color:var(--text-dim);
    padding:3px 7px; font-family:'IBM Plex Mono',monospace;
    white-space:nowrap;
  }
  .note-btn.has-note{ color:var(--accent); border-color:var(--accent-dim); }

  .note-panel{
    display:none; margin-top:10px; padding-top:10px;
    border-top:1px dashed var(--border);
  }
  .note-panel.open{ display:block; }
  .note-panel textarea{
    width:100%; min-height:56px; resize:vertical;
    background:var(--surface3); border:1px solid var(--border);
    border-radius:6px; color:var(--text); font-size:13px;
    padding:8px 10px; font-family:inherit; outline:none;
  }
  .note-panel textarea:focus{ border-color:var(--accent); }
  .save-hint{ font-size:10.5px; color:var(--text-dim); margin-top:4px; }

  .section-divider{
    display:flex; align-items:center; gap:10px;
    margin:22px 0 10px; color:var(--text-dim);
    font-family:'IBM Plex Mono',monospace; font-size:11px;
    text-transform:uppercase; letter-spacing:0.08em;
  }
  .section-divider::after{
    content:''; flex:1; height:1px; background:var(--border);
  }

  footer{
    max-width:1100px; margin:0 auto; padding:20px; color:var(--text-dim);
    font-size:11.5px; border-top:1px solid var(--border);
  }
  footer a{ color:var(--text-muted); }

  ::-webkit-scrollbar{ width:10px; }
  ::-webkit-scrollbar-track{ background:var(--bg); }
  ::-webkit-scrollbar-thumb{ background:var(--surface3); border-radius:5px; }

  @media (max-width:600px){
    .row{ flex-wrap:wrap; }
    .row-actions{ flex-direction:row; margin-left:auto; }
    .count-badge{ width:100%; margin-left:0; order:10; }
  }
</style>
</head>
<body>

<header>
