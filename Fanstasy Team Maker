let boardOnly = false;
let storageReady = false;

const STORAGE_KEY = 'fantasyBoard:userData:v1';

async function loadState(){
  try{
    const res = await window.storage.get(STORAGE_KEY, false);
    if(res && res.value){ userState = JSON.parse(res.value); }
  }catch(e){ userState = {}; }
  storageReady = true;
}

let saveTimer = null;
function persistState(){
  if(saveTimer) clearTimeout(saveTimer);
  saveTimer = setTimeout(async ()=>{
    try{ await window.storage.set(STORAGE_KEY, JSON.stringify(userState), false); }
    catch(e){ console.error('save failed', e); }
  }, 350);
}

function getEntry(id){
  if(!userState[id]) userState[id] = {star:false, note:''};
  return userState[id];
}

// ---- Render ----
function renderScoringChips(){
  const chips = [
    'Half-PPR (0.5/rec)','Pass TD +6','INT -2','25 yds/pt passing (assumed)',
    '10 yds/pt rush & rec','Rush/Rec TD +10','Fumble lost -2',
    'FG 0–39 +3 · 40–49 +4 · 50+ +5','Sack/INT/FumRec +2','Safety +5','Blocked kick +3',
    '0 PA +14 · 1–6 +12 · 7–13 +10 · 14–20 +8 · 21–27 +6 · 28–34 +4 · 35+ +2'
  ];
  document.getElementById('scoringChips').innerHTML = chips.map(c=>`<span class="chip">${c}</span>`).join('');
}

function renderTabs(){
  const wrap = document.getElementById('posTabs');
  wrap.innerHTML = POS_CONFIG.map(p=>`
    <div class="pos-tab ${activePos===p.key?'active':''}" data-pos="${p.key}">
      ${p.key!=='ALL'?`<span class="dot" style="background:${p.color}"></span>`:''}${p.label}
    </div>
  `).join('');
  wrap.querySelectorAll('.pos-tab').forEach(el=>{
    el.addEventListener('click', ()=>{ activePos = el.dataset.pos; renderTabs(); renderList(); });
  });
}

function posColorVar(pos){
  const map = {QB:'var(--qb)',RB:'var(--rb)',WR:'var(--wr)',TE:'var(--te)',K:'var(--k)',DST:'var(--dst)'};
  return map[pos]||'var(--border)';
}

function matchesFilter(p){
  if(activePos!=='ALL' && p.pos!==activePos) return false;
  if(boardOnly){
    const e = userState[p.id];
    if(!e || !e.star) return false;
  }
  if(searchTerm){
    const t = searchTerm.toLowerCase();
    if(!p.name.toLowerCase().includes(t) && !p.team.toLowerCase().includes(t)) return false;
  }
  return true;
}

function renderList(){
  const main = document.getElementById('main');
  const filtered = players.filter(matchesFilter).sort((a,b)=> (a.rank||999) - (b.rank||999));

  const starCount = Object.values(userState).filter(v=>v && v.star).length;
  document.getElementById('countBadge').textContent = `${filtered.length} shown · ${starCount} starred`;

  if(filtered.length===0){
    main.innerHTML = `<div class="empty-state">No players match. Try a different search or turn off "My Board".</div>`;
    return;
  }

  main.innerHTML = filtered.map(p=>{
    const entry = getEntry(p.id);
    const isStar = !!entry.star;
    const hasNote = !!(entry.note && entry.note.trim());
    const byeText = p.bye ? `Bye ${p.bye}` : '';
    const ppgText = p.ppg!=null ? (p.pos==='K'||p.pos==='DST' ? `${p.ppg} proj pts` : `${p.ppg} PPG`) : '';
    const sched = SCHEDULE_NOTE[p.team];

    return `
    <div class="row ${isStar?'highlighted':''}" style="--pos-color:${posColorVar(p.pos)}" data-id="${p.id}">
      <div class="rank-badge">${p.rank && p.rank<=999 ? p.rank : '—'}</div>
      <div class="row-main">
        <div class="row-top">
          <span class="player-name">${p.name}</span>
          <span class="pos-chip">${p.posRank}</span>
          <span class="team-bye">${p.team}${byeText ? ' · '+byeText : ''}</span>
        </div>
        <div class="tier-label">${p.tier}</div>
        <div class="row-meta">
          ${ppgText ? `<span class="tag ppg">${ppgText}</span>` : ''}
          ${p.injury ? `<span class="tag injury">⚑ ${p.injury}</span>` : ''}
          ${sched ? `<span class="tag ${sched.type==='good'?'schedule-good':'schedule-bad'}">${sched.type==='good'?'↑':'↓'} ${sched.text}</span>` : ''}
        </div>
        <div class="note-panel ${hasNote ? '' : ''}" id="notepanel-${p.id}">
          <textarea placeholder="Your notes on ${p.name}… (e.g. 'target in round 4', 'handcuff to X')" data-id="${p.id}">${entry.note||''}</textarea>
          <div class="save-hint">Saved automatically to your account.</div>
        </div>
      </div>
      <div class="row-actions">
        <button class="star-btn ${isStar?'active':''}" data-id="${p.id}" title="Highlight this pick">${isStar?'★':'☆'}</button>
        <button class="note-btn ${hasNote?'has-note':''}" data-id="${p.id}">${hasNote?'Note ✓':'+ Note'}</button>
      </div>
    </div>`;
  }).join('');

  // wire up events
  main.querySelectorAll('.star-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const id = btn.dataset.id;
      const e = getEntry(id);
      e.star = !e.star;
      persistState();
      renderList();
    });
  });
  main.querySelectorAll('.note-btn').forEach(btn=>{
    btn.addEventListener('click', ()=>{
      const panel = document.getElementById('notepanel-'+btn.dataset.id);
      panel.classList.toggle('open');
      if(panel.classList.contains('open')){
        const ta = panel.querySelector('textarea');
        ta.focus();
      }
    });
  });
  main.querySelectorAll('textarea').forEach(ta=>{
    ta.addEventListener('input', ()=>{
      const e = getEntry(ta.dataset.id);
      e.note = ta.value;
      persistState();
    });
  });
}

function wireControls(){
  document.getElementById('searchInput').addEventListener('input', (e)=>{
    searchTerm = e.target.value;
    renderList();
  });
  const boardToggle = document.getElementById('boardToggle');
  boardToggle.addEventListener('click', ()=>{
    boardOnly = !boardOnly;
    boardToggle.classList.toggle('active', boardOnly);
    renderList();
  });
}

async function init(){
  renderScoringChips();
  renderTabs();
  wireControls();
  main_loading();
  await loadState();
  renderList();
}

function main_loading(){
  document.getElementById('main').innerHTML = `<div class="empty-state">Loading your board…</div>`;
}

init();
</script>
</body>
</html>